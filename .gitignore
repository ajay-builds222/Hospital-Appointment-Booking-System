```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]

# Uploaded files
uploads/*
!uploads/.gitkeep

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE and editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
```
